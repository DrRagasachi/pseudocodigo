/* 

Usando base 10: 
  - Usamos la funcion MOD 10 para obtener el primer digito de la derecha.
  - Usamos la funcion DIV 10 para quitar la cifra que obtuvimos arriba.

*/

Algoritmo mi_algoritmo
  
   Definir num Como Entero;
  

  Repetir
    Escribir " Ingresa un numero entero positivo : ";
    Leer num; // vamos a trabajar con 4321
  
  Hasta Que num > 0       
  
  Imprimir "El numero ingresado es : " , num;

  Imprimir " Se procede a descomponer : " 

FinAlgoritmo
